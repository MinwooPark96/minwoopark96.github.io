---
layout: null
sitemap:
  exclude: 'yes'
---
[
  {% for post in site.posts %}
    {
      "title"    : {{ post.title | jsonify }},
      "title-lower" : {{ post.title | downcase | jsonify }},
      "subtitle" : {{ post.subtitle | default: '' | jsonify }},
      "subtitle-lower" : {{ post.subtitle | default: '' | downcase | jsonify }},
      "categories" : {{ post.categories | join: ', ' | jsonify }},
      "tags"     : {{ post.tags | join: ', ' | jsonify }},
      "url"      : {{ post.url | relative_url | jsonify }},
      "date"     : {{ post.date | date_to_xmlschema | jsonify }},
      "content"  : {{ post.content | strip_html | normalize_whitespace | truncate: 200 | jsonify }}
    } {% unless forloop.last %},{% endunless %}
  {% endfor %}
]
